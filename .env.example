# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
# -----------------------------------------------------------------------------

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser; RLS decides what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Server only: contact-form inserts, rate limiting, admin bootstrap.
SUPABASE_SERVICE_ROLE_KEY=

# Super Admin bootstrap (npm run admin:create). The password is temporary:
# a change is forced at first sign-in. Remove it from the environment afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: email notifications for new enquiries (https://resend.com)
RESEND_API_KEY=
# Fallback recipient(s), comma-separated. Normally set by the owner in
# CMS → Settings → Notifications, which takes precedence.
CONTACT_EMAIL=
# Verified sender, e.g. "Website <enquiries@yourdomain.com>"
RESEND_FROM_EMAIL=

# Fallback WhatsApp number (digits incl. country code) if none is set in
# Dashboard → Settings → Contact
WHATSAPP_PHONE=

# Optional
# Canonical origin, e.g. https://www.example.com (otherwise SEO setting / Vercel URL)
NEXT_PUBLIC_SITE_URL=
# Salt for hashing client IPs in rate limiting (defaults to a server secret)
RATE_LIMIT_SALT=
