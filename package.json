{
  "name": "surface-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:db": "tsx scripts/test-database.ts",
    "check": "npm run lint && npm run typecheck && npm run test:db && npm run build",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.generated.ts",
    "local:start": "supabase start -x realtime,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor,studio,postgres-meta",
    "local:start:studio": "supabase start -x realtime,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "local:env": "tsx scripts/setup-local-env.ts",
    "local:reset": "supabase db reset",
    "local:stop": "supabase stop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
